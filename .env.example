# (Optional) Supabase Configuration
# If provided, MEDORA uses remote Supabase persistence for extended data.
# If omitted, MEDORA runs in standalone demo mode with high-fidelity canonical in-memory stores.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

