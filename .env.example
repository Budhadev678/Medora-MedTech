# MEDORA Platform — Environment Configuration Template
# For production/staging, replace with your live Supabase project credentials.
# For local prototype demo, default fallback/mock adapters are enabled when credentials are not configured.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SIH Demo Mode (Set to true to enable one-click persona switcher and seeded data)
NEXT_PUBLIC_DEMO_MODE=true
